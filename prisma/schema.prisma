generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  COD
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  NEW_ORDER
  PAYMENT_RECEIVED
  LOW_STOCK
  ORDER_STATUS
  REVIEW_SUBMITTED
  BULK_ENQUIRY
  SYSTEM
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  reviews       Review[]
  addresses     Address[]
  notifications Notification[]
  cart          Cart?
  wishlist      Wishlist?

  @@index([email])
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  email        String
  phone        String
  houseFlat    String
  street       String
  area         String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Mukhi {
  id                    String    @id @default(uuid())
  number                Int       @unique
  name                  String
  sanskritTitle         String
  summary               String
  rulingDeity           String
  traditionalAssociation String
  planetaryAssociation String?
  mantra                String
  description           String
  whoShouldWear         String
  image                 String
  products              Product[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Product {
  id                       String         @id @default(uuid())
  slug                     String         @unique
  name                     String
  sanskritName             String?
  shortDescription         String
  description              String
  story                    String
  price                    Int
  compareAtPrice           Int?
  currency                 String         @default("INR")
  sku                      String         @unique
  categoryId               String?
  category                 Category?      @relation(fields: [categoryId], references: [id])
  mukhiId                  String?
  mukhiRel                 Mukhi?         @relation(fields: [mukhiId], references: [id])
  mukhi                    Int?
  size                     String
  weight                   String?
  origin                   String
  material                 String
  stockQuantity            Int            @default(10)
  status                   ProductStatus  @default(ACTIVE)
  featured                 Boolean        @default(false)
  bestSeller               Boolean        @default(false)
  badges                   String[]       @default([])
  features                 String[]       @default([])
  traditionalSignificance  String[]       @default([])
  howToUse                 String[]       @default([])
  careInstructions         String[]       @default([])
  authenticityInformation  String[]       @default([])
  packagingDesc            String?
  secondLifeUse            String?
  thumbnail                String
  images                   ProductImage[]
  cartItems                CartItem[]
  wishlistItems            WishlistItem[]
  orderItems               OrderItem[]
  reviews                  Review[]
  inventoryLogs            InventoryLog[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([slug])
  @@index([status])
  @@index([mukhi])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  type      String   @default("main")
  order     Int      @default(0)
}

model Cart {
  id           String     @id @default(uuid())
  userId       String?    @unique
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?    @unique
  items        CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CartItem {
  id              String   @id @default(uuid())
  cartId          String
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int      @default(1)
  selectedVariant String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Wishlist {
  id           String         @id @default(uuid())
  userId       String?        @unique
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String?        @unique
  items        WishlistItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Order {
  id                 String         @id @default(uuid())
  orderNumber        String         @unique // e.g. RB-2026-000001
  userId             String?
  user               User?          @relation(fields: [userId], references: [id])
  customerName       String
  customerEmail      String
  customerPhone      String
  subtotal           Int
  shippingAmount     Int            @default(0)
  discountAmount     Int            @default(0)
  totalAmount        Int
  currency           String         @default("INR")
  paymentStatus      PaymentStatus  @default(PENDING)
  orderStatus        OrderStatus    @default(PENDING)
  deliveryMethod     String         @default("standard")
  paymentMethod      PaymentMethod  @default(UPI)
  
  // Shipping Address Details (Snapshot)
  shippingAddress    Json
  billingAddress     Json?

  // Payment Tracking
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?

  // Fulfillment Tracking
  courierPartner     String?
  trackingNumber     String?
  estimatedDelivery  DateTime?
  notes              String?

  items              OrderItem[]
  payments           Payment[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([orderStatus])
  @@index([paymentStatus])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  name        String
  price       Int
  quantity    Int
  thumbnail   String
  size        String?
  createdAt   DateTime @default(now())
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  failureReason     String?
  rawResponse       Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Review {
  id               String       @id @default(uuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?        @relation(fields: [userId], references: [id])
  author           String
  location         String
  rating           Int
  title            String
  comment          String
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([productId])
  @@index([status])
}

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  discountType      DiscountType @default(PERCENTAGE)
  discountValue     Int          // e.g. 10 for 10% or 500 for ₹500
  minOrderAmount    Int          @default(0)
  maxDiscountAmount Int?
  startDate         DateTime     @default(now())
  endDate           DateTime?
  usageLimit        Int?
  timesUsed         Int          @default(0)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model InventoryLog {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  changeQuantity Int      // e.g. -1 for order, +10 for restocking
  previousStock  Int
  newStock       Int
  reason         String   // "Order placement", "Manual adjustment", "Return refund"
  orderId        String?
  createdAt      DateTime @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(NEW_ORDER)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  subtitle    String
  excerpt     String
  content     String   @db.Text
  category    String
  authorName  String
  authorRole  String
  publishedAt DateTime @default(now())
  readTime    String
  coverImage  String
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BulkEnquiry {
  id                   String   @id @default(uuid())
  name                 String
  company              String?
  email                String
  phone                String
  quantity             Int
  eventType            String
  budgetRange          String
  customizationDetails String
  message              String?
  status               String   @default("NEW") // NEW, CONTACTED, CLOSED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model BusinessSettings {
  id                    String   @id @default(uuid())
  storeName             String   @default("RUDRABEEJ")
  tagline               String   @default("The Seed of Rudra.")
  storeEmail            String   @default("care@rudrabeej.com")
  supportPhone          String   @default("+91 98765 43210")
  whatsappNumber        String   @default("+919876543210")
  currency              String   @default("INR")
  freeShippingThreshold Int      @default(999)
  standardShippingFee   Int      @default(99)
  expressShippingFee    Int      @default(150)
  codAvailable          Boolean  @default(true)
  returnWindowDays      Int      @default(7)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
