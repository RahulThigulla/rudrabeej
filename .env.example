# ==========================================
# RUDRABEEJ E-COMMERCE CONFIGURATION
# ==========================================

# 1. Site Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="RUDRABEEJ | The Seed of Rudra."

# 2. Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rudrabeej_db?schema=public"

# 3. Authentication Secrets
AUTH_SECRET="rudrabeej_super_secret_jwt_key_2026_change_in_production"

# 4. Payment Gateway Modes: 'mock' (for instant dev simulation) | 'razorpay' (for live)
PAYMENT_MODE=mock
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# 5. Notifications Mode: 'mock' (logs to console/admin inbox) | 'production' (live SMTP & WhatsApp)
NOTIFICATION_MODE=mock

# 6. Email Settings (Nodemailer / SMTP)
EMAIL_FROM="RUDRABEEJ <care@rudrabeej.com>"
ADMIN_EMAIL="admin@rudrabeej.com"
EMAIL_SERVER="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USERNAME="care@rudrabeej.com"
EMAIL_PASSWORD="app_specific_password_here"

# 7. WhatsApp Business API Settings
WHATSAPP_API_URL="https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages"
WHATSAPP_API_TOKEN="your_whatsapp_bearer_token"
WHATSAPP_ADMIN_NUMBER="+919876543210"
NEXT_PUBLIC_WHATSAPP_NUMBER="+919876543210"
